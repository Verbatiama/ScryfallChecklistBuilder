# Copy this file to .env (git ignored) and fill in your project's values
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key: bypasses RLS, so never commit it
SUPABASE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_TABLE=cards

# Local clone of the collection storage repo; collection.json and FullCards.json are written there for review
COLLECTION_REPO_PATH=C:\path\to\LegendaryCreatureCollectionStorage
